@model IEnumerable<Category>

@{
    ViewData["Title"] = "Category Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome Category</h1>
</div>


<div class="container">
    <div class="row text-end">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary">Create New Category</a>
        </div>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    ID
                </th>
                <th>
                    Name
                </th>
                <th>Actions</th>
               
            </tr>
        </thead>

        <tbody>
            @foreach (var name in Model)
            {

                <tr>
                    <td>
                        @name.Id
                    </td>
                    <td>
                        @name.Name
                    </td>
                    <td>
                        <a asp-action="Edit"  class="btn btn-warning">Edit</a>
                        <a asp-action="Delete"  class="btn btn-danger">Delete</a>
                    </td>
                  
                </tr>
            }


        </tbody>

    </table>


</div>

