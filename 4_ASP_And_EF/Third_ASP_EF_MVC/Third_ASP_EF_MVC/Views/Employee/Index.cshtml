@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employee Page";
    int count = 1;
}

<div class="text-center">
    <h1 class="display-4">Welcome Employee</h1>
   </div>


   <div class="container">
       <a asp-action="Create" class="btn btn-primary mb-3">Create New Employee</a>  
       <table class="table table-striped">
           <thead>
               <tr>
                <th>
                    #
                </th>
                   <th>
                       ID
                   </th>
                <th>
                    Name
                </th>
                <th>
                    Description
                </th>
                <th>Actions</th>
                
               </tr>
           </thead>

           <tbody>
              
            @foreach(var name in Model)
            {
                
                <tr>
                    <td>
                        @count
                        @{
                            count++;
                        }
                    </td>

                    <td>
                        @name.Id
                    </td>
                    <td>
                        @name.Name
                    </td>
                    <td>
                        @name.Description
                    </td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@name.Id" class="btn btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@name.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                       
                    </td>
                  
                </tr>
            }


           </tbody>

       </table>


   </div>

